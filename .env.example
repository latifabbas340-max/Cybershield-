```env
# Copy this file to .env and fill in real values before running.
# Never commit your actual .env file.

# Required in production. In development, a random key is generated
# automatically each run if this is left blank (sessions won't persist).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "development" or "production". In production, SECRET_KEY is required
# and the app will refuse to start without it.
FLASK_ENV=development

# Set to "true" only for local development. Never enable in production —
# Flask's debugger allows remote code execution if exposed.
FLASK_DEBUG=false

# Bind address. Defaults to 127.0.0.1 (localhost only). Set to 0.0.0.0
# only if you understand the exposure and are behind a firewall/proxy.
HOST=127.0.0.1

PORT=5000

# Only set to "true" if this app is deployed behind a reverse proxy
# (nginx, Caddy, a load balancer) that sets/overwrites X-Forwarded-For.
# Otherwise leave false -- trusting this header from untrusted clients
# lets them spoof their IP and bypass rate limiting.
TRUST_PROXY_HEADERS=false
```
